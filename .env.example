# Copy this file to .env and fill in local values. Never commit .env.
TYPESAFE_API_KEY=
OPENAI_API_KEY=
LONGMEMEVAL_PATH=C:\datasets\LongMemEval\longmemeval_s_cleaned.json
LONGMEMEVAL_ORACLE_PATH=C:\datasets\LongMemEval\longmemeval_oracle.json
OPENAI_MODEL=gpt-4o
JEV_ROUTING_BATCH_SIZE=25
EMBEDDING_BATCH_SIZE=256
RERANKER_BATCH_SIZE=64

# CPU-optimized Snowflake embeddings with the repository's INT8 ONNX graph:
# EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-xs
# EMBEDDING_BACKEND=onnx
# EMBEDDING_ONNX_FILE=onnx/model_int8.onnx
# EMBEDDING_QUERY_PROMPT_NAME=query
# EMBEDDING_THREADS=4

# Optional local model directories:
# EMBEDDING_MODEL=C:\models\all-MiniLM-L6-v2
# RERANKER_MODEL=C:\models\ms-marco-MiniLM-L-6-v2
